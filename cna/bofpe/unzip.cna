beacon_command_register(
    "unzip",
    "Extract a ZIP archive into a new directory on the target",

    "Extract a ZIP archive into a directory that does not exist yet.\n\n" .
    "Usage:\n" .
    "  unzip <archive.zip> <new-directory>\n\n" .
    "Arguments:\n" .
    "  archive.zip      ZIP archive on the target\n" .
    "  new-directory    Destination directory; it must not already exist\n\n" .
    "Archives are rejected if they contain path traversal, absolute or " .
    "otherwise unsafe paths, links, encrypted entries, or unsupported " .
    "compression methods. Archives may contain at most 100,000 entries and " .
    "8 GiB of uncompressed data.\n\n" .
    "If extraction fails, a partially extracted directory may remain; delete " .
    "it before retrying. The command runs synchronously, so Beacon is " .
    "blocked until it finishes.\n\n" .
    "Example:\n" .
    "  unzip C:\\Windows\\Temp\\example.zip " .
    "C:\\Windows\\Temp\\extracted-example\n"
);

alias unzip {
    local('$bid $arch $handle $pe $args');

    $bid = @_[0];
    if (size(@_) != 3) {
        berror($bid, "Usage: unzip <archive.zip> <new-directory>");
        return;
    }
    $arch = barch($bid);
    if ($arch ne "x64" && $arch ne "x86") {
        berror($bid, "Unzip BOF-PE supports x86 and x64 Beacons only.");
        return;
    }
    $handle = openf(script_resource("unzip." . $arch . ".exe"));
    $pe = readb($handle, -1);
    closef($handle);
    $args = bof_pack($bid, "ZZ", @_[1], @_[2]);
    btask($bid, "Extracting ZIP archive " . @_[1] . " into " . @_[2]);
    beacon_inline_execute_pe($bid, $pe, "go", $args);
}
